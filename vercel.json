{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(login|dashboard(?:/.*)?|staff(?:/.*)?|admission(?:/.*)?)",
      "headers": {
        "Location": "https://shamsul-ulama-w2kv.hatchable.site/$1"
      },
      "status": 307
    },
    {
      "src": "/api/(.*)",
      "dest": "https://shamsul-ulama-w2kv.hatchable.site/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/(.*\\.(?:html|svg|png|jpg|jpeg|webp|avif|gif|ico|pdf|txt|xml|webmanifest))",
      "dest": "/public/$1"
    },
    {
      "src": "/.*",
      "dest": "/public/index.html"
    }
  ]
}
